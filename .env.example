# Paypack API Credentials
PAYPACK_CLIENT_ID=your_client_id
PAYPACK_CLIENT_SECRET=your_client_secret

# Gemini API key (used by the AI assistant feature)
GEMINI_API_KEY=

# Backend API base URL.
# Leave empty in development — the Vite proxy (/api → http://localhost:4000) handles it.
# In production set this to your backend's public URL, e.g.:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=
