# PostgreSQL connection string
DATABASE_URL=

# Port for the backend server (default: 4000)
PORT=4000

# Allowed CORS origins (comma-separated, default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Absolute path to uploads directory, used only to serve legacy pre-R2 images
# still referenced as /uploads/... in the database. New uploads go to R2 (below)
# and don't use this. Defaults to <project_root>/public/uploads (one level above backend/).
# UPLOADS_DIR=/absolute/path/to/uploads

# Cloudflare R2 (S3-compatible object storage) — required for image uploads.
# Create a bucket + API token in the Cloudflare dashboard (R2 > Manage R2 API Tokens),
# and enable the bucket's public access (r2.dev subdomain, or a custom domain) for
# R2_PUBLIC_URL. All five are required or the upload route will fail to start.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket, no trailing slash, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Set to "production" on the host. Also enables DB SSL automatically (see PGSSL).
NODE_ENV=development

# Set to "true" to force SSL on the DB connection (needed for most hosted
# Postgres providers like Neon/Supabase/Render). Not needed if NODE_ENV=production,
# which already enables it. Leave unset for local Postgres.
PGSSL=

# Gmail account used to send admin password verification codes.
# EMAIL_APP_PASSWORD is a 16-character Google "App Password" (requires 2-Step
# Verification enabled on the account), NOT the account's normal login password.
# Generate one at https://myaccount.google.com/apppasswords
EMAIL_USER=iwacueucompanyltd@gmail.com
EMAIL_APP_PASSWORD=

# Inbox that receives admin password verification codes.
COMPANY_EMAIL=iwacueucompanyltd@gmail.com
