# PostgreSQL connection string


# Port for the backend server (default: 4000)


# Allowed CORS origins (comma-separated, default: http://localhost:5173)


# Absolute path to uploads directory.
# Defaults to <project_root>/public/uploads (one level above backend/).
# UPLOADS_DIR=/absolute/path/to/uploads

# Gmail account used to send admin password verification codes.
# EMAIL_APP_PASSWORD is a 16-character Google "App Password" (requires 2-Step
# Verification enabled on the account), NOT the account's normal login password.
# Generate one at https://myaccount.google.com/apppasswords
EMAIL_USER=iwacueucompanyltd@gmail.com
EMAIL_APP_PASSWORD=

# Inbox that receives admin password verification codes.
COMPANY_EMAIL=iwacueucompanyltd@gmail.com
